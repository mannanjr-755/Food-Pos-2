{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && npm run install:all",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": [
        "backend/dist/**",
        "backend/prisma/prod.db"
      ]
    }
  },
  "rewrites": [
    { "handle": "filesystem" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}