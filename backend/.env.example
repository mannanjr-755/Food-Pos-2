# Backend environment variables
# Copy this file to .env and fill in values

NODE_ENV=development
PORT=5000

# MongoDB (the POS owns this database — it is not shared with any other app)
MONGODB_URI=mongodb://127.0.0.1:27017/food_pos

# Auth — required in production; the server refuses to start without a signing secret
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Staff PIN unlock (numeric). Default is 12345 if unset.
POS_PIN=12345

# Extra origins allowed to call the API. The SPA and the guest menu are served by this same
# process, so a single-host deployment needs no entry here; use it for the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Where menu photos uploaded from the Menu page are written. Leave unset to use backend/uploads.
# UPLOAD_DIR=uploads

# Built SPA served by this same process (frontend/dist). Leave unset to use the default path.
# CLIENT_DIR=
# Set false once the real menu is loaded; seeding only creates demo staff + demo orders in dev.
AUTO_SEED=true
# true also seeds three demo QR orders on the floor tables
SEED_DEMO_ORDERS=false
