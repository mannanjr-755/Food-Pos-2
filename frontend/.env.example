# Local Vite proxy uses POS_API_TARGET (shell env) → http://localhost:5000 by default.
#
# For Vercel (separate live URL), set the production API origin of the Express backend:
#   VITE_API_BASE_URL=https://your-existing-pos-api.onrender.com/api/v1
#
# Leave unset for same-origin deployments where Express serves the SPA.
# VITE_API_BASE_URL=
